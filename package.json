{
  "name": "zotero-citegeist",
  "version": "3.0.0",
  "description": "Citation intelligence for Zotero — powered by OpenAlex. See citation counts, explore citation networks, and add citing/cited works to your library.",
  "homepage": "https://github.com/phdemotions/zotero-citegeist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phdemotions/zotero-citegeist.git"
  },
  "author": "Josh Gonzales",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "release": "node scripts/release-preflight.mjs && bumpp --commit 'release: v%s' --all --no-tag --no-push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:zotero": "zotero-plugin test --exit-on-finish",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.mjs\"",
    "okf:check": "bash tools/okf-check.sh",
    "okf:drift": "bash tools/okf-drift-check.sh"
  },
  "config": {
    "addonName": "Citegeist",
    "addonID": "citegeist@opusvita.org",
    "addonRef": "citegeist",
    "addonInstance": "Citegeist",
    "prefsPrefix": "extensions.zotero.citegeist",
    "zoteroMinVersion": "7.0.10",
    "zoteroMaxVersion": "10.0.*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "bumpp": "^11.1.0",
    "chai": "4.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.6.0",
    "mocha": "12.0.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.0",
    "vitest": "^4.1.9",
    "yaml": "2.9.0",
    "zotero-plugin-scaffold": "0.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
